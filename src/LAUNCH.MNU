; Launch! 2.6 initial menu definition
; ITEM=title|command and parameters|press Enter|change directory|prompt (0/1)
; SEPARATOR= adds a movable horizontal separator

[Launcher]
FOLDER=DOS Commands
SEPARATOR=

[Launcher\DOS Commands]
ITEM=Check Disk|CHKDSK|1|0|0
ITEM=Format Disk|FORMAT|0|0|0
ITEM=Partition Disk|FDISK|1|0|0
ITEM=Memory Information|MEM|1|0|0
ITEM=File Attributes|ATTRIB|0|0|0
ITEM=Find Text|FIND|0|0|0
ITEM=Sort Text|SORT|0|0|0

