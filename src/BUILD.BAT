@ECHO OFF
REM Launch! build script - Microsoft C/C++ 7.0
REM BUILD with no parameter builds everything.
REM BUILD ! builds only the core Launch! menu and appends its authentication trailer.
REM BUILD !SNAKE (etc.) builds only that accessory.
REM Release 3.6 generated *36TMP.C sources are supplied with this tree.
REM GEN36.C is a maintainer regeneration tool and is not run by BUILD.
IF "%1"=="" GOTO ALL
IF "%1"=="!" GOTO CORE
IF "%1"=="!CAL" GOTO CAL
IF "%1"=="!CALC" GOTO CALC
IF "%1"=="!DRAW" GOTO DRAW
IF "%1"=="!NOTE" GOTO NOTE
IF "%1"=="!JOURNAL" GOTO JOURNAL
IF "%1"=="!STACK" GOTO STACK
IF "%1"=="!SYSINFO" GOTO SYSINFO
IF "%1"=="!BOXES" GOTO BOXES
IF "%1"=="!SOL" GOTO SOL
IF "%1"=="!FCELL" GOTO FREEC
IF "%1"=="!FREEC" GOTO FREEC
IF "%1"=="!TODOS" GOTO TODOS
IF "%1"=="!POP" GOTO POP
IF "%1"=="!SNAKE" GOTO SNAKE
IF "%1"=="!PLUMB" GOTO PLUMB
IF "%1"=="!WORDZ" GOTO WORDZ
IF "%1"=="!TYPO" GOTO TYPO
IF "%1"=="!cal" GOTO CAL
IF "%1"=="!calc" GOTO CALC
IF "%1"=="!draw" GOTO DRAW
IF "%1"=="!note" GOTO NOTE
IF "%1"=="!journal" GOTO JOURNAL
IF "%1"=="!stack" GOTO STACK
IF "%1"=="!sysinfo" GOTO SYSINFO
IF "%1"=="!boxes" GOTO BOXES
IF "%1"=="!sol" GOTO SOL
IF "%1"=="!fcell" GOTO FREEC
IF "%1"=="!freec" GOTO FREEC
IF "%1"=="!todos" GOTO TODOS
IF "%1"=="!pop" GOTO POP
IF "%1"=="!snake" GOTO SNAKE
IF "%1"=="!plumb" GOTO PLUMB
IF "%1"=="!wordz" GOTO WORDZ
IF "%1"=="!typo" GOTO TYPO
ECHO Unknown component: %1
GOTO FAIL
:CORE
CL /AM /Os /Gs /W3 /Fe!.EXE L36TMP.C SAVERS.C
IF ERRORLEVEL 1 GOTO FAIL
COPY /B !.EXE+AUTH35.SIG !.$$$ >NUL
IF ERRORLEVEL 1 GOTO FAIL
DEL !.EXE
REN !.$$$ !.EXE
GOTO CHECK
:CAL
CL /AS /Os /Gs /W3 /Fe!CAL.EXE C36TMP.C ACCLIB36.C
GOTO CHECK
:CALC
CL /AS /Os /Gs /W3 /Fe!CALC.EXE CALC.C ACCLIB36.C
GOTO CHECK
:DRAW
CL /AS /Os /Gs /W3 /Fe!DRAW.EXE DRAW.C ACCLIB36.C
GOTO CHECK
:NOTE
CL /AS /Os /Gs /W3 /Fe!NOTE.EXE N36TMP.C ACCLIB36.C
GOTO CHECK
:JOURNAL
CL /AS /Os /Gs /W3 /Fe!JOURNAL.EXE J36TMP.C ACCLIB36.C
GOTO CHECK
:STACK
CL /AS /Os /Gs /W3 /DACCLIB_MIN_GLYPHS /Fe!STACK.EXE S36TMP.C ACCLIB36.C
GOTO CHECK
:SYSINFO
CL /AS /Os /Gs /W3 /Fe!SYSINFO.EXE Y36TMP.C ACCLIB36.C
GOTO CHECK
:BOXES
CL /AS /Os /Gs /W3 /Fe!BOXES.EXE B36TMP.C ACCLIB36.C
GOTO CHECK
:SOL
CL /AS /Os /Gs /W3 /Fe!SOL.EXE O36TMP.C ACCLIB36.C
GOTO CHECK
:FREEC
CL /AS /Os /Gs /W3 /Fe!FCELL.EXE FREEC.C ACCLIB36.C
GOTO CHECK
:TODOS
CL /AS /Os /Gs /W3 /Fe!TODOS.EXE TODOS.C ACCLIB36.C
GOTO CHECK
:POP
CL /AS /Os /Gs /W3 /Fe!POP.EXE P36TMP.C ACCLIB36.C
GOTO CHECK
:SNAKE
CL /AS /Os /Gs /W3 /Fe!SNAKE.EXE K36TMP.C ACCLIB36.C
GOTO CHECK
:PLUMB
CL /AS /Os /Gs /W3 /Fe!PLUMB.EXE PLUMB.C ACCLIB36.C
GOTO CHECK
:WORDZ
CL /AS /Os /Gs /W3 /Fe!WORDZ.EXE WORDZ.C ACCLIB36.C
GOTO CHECK
:TYPO
CL /AS /Os /Gs /W3 /Fe!TYPO.EXE TYPO.C ACCLIB36.C
GOTO CHECK
:CHECK
IF ERRORLEVEL 1 GOTO FAIL
ECHO Built %1
GOTO END
:ALL
CL /AM /Os /Gs /W3 /Fe!.EXE L36TMP.C SAVERS.C
IF ERRORLEVEL 1 GOTO FAIL
COPY /B !.EXE+AUTH35.SIG !.$$$ >NUL
IF ERRORLEVEL 1 GOTO FAIL
DEL !.EXE
REN !.$$$ !.EXE
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /FeINSTALL.EXE I36TMP.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 PACKDAT.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 AUTOGEN.C
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !CAL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !CALC
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !DRAW
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /Fe!NOTE.EXE N36TMP.C ACCLIB36.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /Fe!JOURNAL.EXE J36TMP.C ACCLIB36.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /DACCLIB_MIN_GLYPHS /Fe!STACK.EXE S36TMP.C ACCLIB36.C
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !SYSINFO
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !BOXES
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !SOL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !FCELL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !TODOS
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !POP
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !SNAKE
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !PLUMB
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !WORDZ
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !TYPO
IF ERRORLEVEL 1 GOTO FAIL
PACKDAT.EXE
IF ERRORLEVEL 1 GOTO FAIL
ECHO Built complete Launch! distribution
GOTO END
:FAIL
ECHO Build failed.
:END
