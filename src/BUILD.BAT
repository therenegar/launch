REM Launch! for DOS ---------------------
REM MAINTAINER NOTES - Launch! 3.73
REM File: BUILD.BAT
REM Role: Primary DOS build script
REM Build/ownership: Builds complete suite or named component and captures transcript in BUILD.LOG.
REM Maintainer contract: Keep component labels synchronized with shipped programs. A failed PACKDAT means binaries may have built even though release packaging did not.
REM Documentation note: comments describe intent and invariants; behavior remains defined by the code and Release requirements.
REM DOS constraints: code targets 16-bit DOS/MS C 7-era models. Watch DGROUP (<64K in small model), stack use, far/near pointers, BIOS/DOS reentrancy and text-mode screen restoration.
@ECHO OFF
REM Launch! build script - Microsoft C/C++ 7.0
REM Top-level builds are captured in BUILD.LOG, then echoed to the screen.
REM Nested component builds inherit the top-level redirection.
IF "%L372LOGGING%"=="1" GOTO LOGGEDSTART
SET L372LOGGING=1
IF EXIST BUILD.LOG DEL BUILD.LOG
CALL BUILD %1 >BUILD.LOG
IF ERRORLEVEL 1 GOTO LOGSHOWFAIL
TYPE BUILD.LOG
SET L372LOGGING=
GOTO END
:LOGSHOWFAIL
TYPE BUILD.LOG
SET L372LOGGING=
ECHO Build failed. See BUILD.LOG for the complete transcript.
GOTO END
:LOGGEDSTART
REM BUILD with no parameter builds everything.
REM BUILD ! builds only the core Launch! menu and appends its authentication trailer.
REM BUILD !SNAKE (etc.) builds only that accessory.
REM Release 3.73 generated build sources are supplied with this tree.
REM GENBUILD.C is a maintainer regeneration tool and is not run by BUILD.
IF "%1"=="" GOTO ALL
IF "%1"=="!" GOTO CORE
IF "%1"=="!CAL" GOTO CAL
IF "%1"=="!CALC" GOTO CALC
IF "%1"=="!DRAW" GOTO DRAW
IF "%1"=="!NOTE" GOTO NOTE
IF "%1"=="!JOURNAL" GOTO JOURNAL
IF "%1"=="!MKDOWN" GOTO MKDOWN
IF "%1"=="!STACK" GOTO STACK
IF "%1"=="!DFETCH" GOTO DFETCH
IF "%1"=="!BOXES" GOTO BOXES
IF "%1"=="!SOL" GOTO SOL
IF "%1"=="!FCELL" GOTO FREEC
IF "%1"=="!FREEC" GOTO FREEC
IF "%1"=="!TODOS" GOTO TODOS
IF "%1"=="!POP" GOTO POP
IF "%1"=="!SNAKE" GOTO SNAKE
IF "%1"=="!PLUMB" GOTO PLUMB
IF "%1"=="!WORDZ" GOTO WORDZ
IF "%1"=="!TYPO" GOTO TYPO
IF "%1"=="!cal" GOTO CAL
IF "%1"=="!calc" GOTO CALC
IF "%1"=="!draw" GOTO DRAW
IF "%1"=="!note" GOTO NOTE
IF "%1"=="!journal" GOTO JOURNAL
IF "%1"=="!mkdown" GOTO MKDOWN
IF "%1"=="!stack" GOTO STACK
IF "%1"=="!dfetch" GOTO DFETCH
IF "%1"=="!boxes" GOTO BOXES
IF "%1"=="!sol" GOTO SOL
IF "%1"=="!fcell" GOTO FREEC
IF "%1"=="!freec" GOTO FREEC
IF "%1"=="!todos" GOTO TODOS
IF "%1"=="!pop" GOTO POP
IF "%1"=="!snake" GOTO SNAKE
IF "%1"=="!plumb" GOTO PLUMB
IF "%1"=="!wordz" GOTO WORDZ
IF "%1"=="!typo" GOTO TYPO
ECHO Unknown component: %1
GOTO FAIL
:CORE
CL /AM /Os /Gs /W3 /Fe!.EXE COREBLD.C SAVERS.C
IF ERRORLEVEL 1 GOTO FAIL
COPY /B !.EXE+AUTH35.SIG !.$$$ >NUL
IF ERRORLEVEL 1 GOTO FAIL
DEL !.EXE
REN !.$$$ !.EXE
GOTO CHECK
:CAL
CL /AS /Os /Gs /W3 /Fe!CAL.EXE CALBLD.C ACCLIBX.C
GOTO CHECK
:CALC
CL /AS /Os /Gs /W3 /Fe!CALC.EXE CALC.C ACCLIBX.C
GOTO CHECK
:DRAW
CL /AS /Os /Gs /W3 /Fe!DRAW.EXE DRAW.C ACCLIBX.C
GOTO CHECK
:NOTE
CL /AS /Os /Gs /W3 /Fe!NOTE.EXE NOTEBLD.C ACCLIBX.C
GOTO CHECK
:JOURNAL
CL /AS /Os /Gs /W3 /Fe!JOURNAL.EXE JOURBLD.C ACCLIBX.C
GOTO CHECK
:MKDOWN
CL /AM /Os /Gs /W3 /F 1000 /Fe!MKDOWN.EXE MKDOWN.C MDFONTS.C ACCLIBX.C
GOTO CHECK
:STACK
CL /AS /Os /Gs /W3 /DACCLIB_MIN_GLYPHS /Fe!STACK.EXE STACKBLD.C ACCLIBX.C
GOTO CHECK
:DFETCH
CL /AS /Os /Gs /W3 /Fe!DFETCH.EXE FETCHBLD.C ACCLIBX.C
GOTO CHECK
:BOXES
CL /AS /Os /Gs /W3 /Fe!BOXES.EXE BOXBLD.C ACCLIBX.C
GOTO CHECK
:SOL
CL /AS /Os /Gs /W3 /Fe!SOL.EXE SOLBLD.C ACCLIBX.C
GOTO CHECK
:FREEC
CL /AS /Os /Gs /W3 /Fe!FCELL.EXE FREEC.C ACCLIBX.C
GOTO CHECK
:TODOS
CL /AS /Os /Gs /W3 /Fe!TODOS.EXE TODOS.C ACCLIBX.C
GOTO CHECK
:POP
CL /AS /Os /Gs /W3 /Fe!POP.EXE POPBLD.C ACCLIBX.C
GOTO CHECK
:SNAKE
CL /AS /Os /Gs /W3 /Fe!SNAKE.EXE SNAKEBLD.C ACCLIBX.C
GOTO CHECK
:PLUMB
CL /AS /Os /Gs /W3 /Fe!PLUMB.EXE PLUMB.C ACCLIBX.C
GOTO CHECK
:WORDZ
CL /AS /Os /Gs /W3 /Fe!WORDZ.EXE WORDZ.C ACCLIBX.C
GOTO CHECK
:TYPO
CL /AS /Os /Gs /W3 /Fe!TYPO.EXE TYPO.C ACCLIBX.C
GOTO CHECK
:CHECK
IF ERRORLEVEL 1 GOTO FAIL
IF "%L371FULL%"=="1" GOTO CHECKDONE
REM Keep the installer synchronized after every focused component build.
CL /AS /Os /Gs /W3 /FeINSTALL.EXE INSTBLD.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 PACKDAT.C
IF ERRORLEVEL 1 GOTO FAIL
PACKDAT.EXE
IF ERRORLEVEL 1 GOTO FAIL
ECHO Built %1 and refreshed INSTALL.EXE / INSTALL.DAT
GOTO END
:CHECKDONE
ECHO Built %1
GOTO END
:ALL
SET L371FULL=1
CL /AM /Os /Gs /W3 /Fe!.EXE COREBLD.C SAVERS.C
IF ERRORLEVEL 1 GOTO FAIL
COPY /B !.EXE+AUTH35.SIG !.$$$ >NUL
IF ERRORLEVEL 1 GOTO FAIL
DEL !.EXE
REN !.$$$ !.EXE
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /FeINSTALL.EXE INSTBLD.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 PACKDAT.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /Fe!MNUGEN.EXE AUTOGEN.C
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !CAL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !CALC
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !DRAW
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /Fe!NOTE.EXE NOTEBLD.C ACCLIBX.C
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /Fe!JOURNAL.EXE JOURBLD.C ACCLIBX.C
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !MKDOWN
IF ERRORLEVEL 1 GOTO FAIL
CL /AS /Os /Gs /W3 /DACCLIB_MIN_GLYPHS /Fe!STACK.EXE STACKBLD.C ACCLIBX.C
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !DFETCH
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !BOXES
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !SOL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !FCELL
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !TODOS
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !POP
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !SNAKE
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !PLUMB
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !WORDZ
IF ERRORLEVEL 1 GOTO FAIL
CALL BUILD !TYPO
IF ERRORLEVEL 1 GOTO FAIL
PACKDAT.EXE
IF ERRORLEVEL 1 GOTO FAIL
SET L371FULL=
ECHO Built complete Launch! distribution
GOTO END
:FAIL
SET L371FULL=
ECHO Build failed.
:END
